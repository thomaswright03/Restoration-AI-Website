# Copy to .env.local for local testing (npm run serve reads it; a variable set in
# the shell wins), or set these as Environment Variables in the Vercel project
# (Settings > Environment Variables). Never commit real values (.env.local is
# git-ignored).
# With none set, the site runs in demo mode: the designer demo works, sign-up says
# accounts aren't switched on yet.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys; use test keys sk_test_... first)
STRIPE_SECRET_KEY=
# Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Product catalog > the monthly price IDs (price_...) for each plan. Give each price
# a lookup key (or "plan" metadata) of starter, pro or max too, so the webhook knows
# the plan. PRO and MAX may list several IDs (comma-separated); checkout uses the first.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# Optional: pin a different Stripe API version than api/_lib.js does
STRIPE_API_VERSION=
# Promo codes for a free first week, typed on the account page before checkout.
# Comma-separated; add :days for a different length (FREEWEEK,LAUNCH30:30). Days without
# a number come from plans.promoFreeDays in site-config.json. Unset = FREEWEEK; "none" = off.
PROMO_CODES=FREEWEEK
# Optional: a free trial for EVERY first subscription, code or not. Leave empty.
TRIAL_DAYS=

# Optional: your real domain, used for Stripe return links (defaults to the request's host)
SITE_URL=

# Test-only, never needed in Vercel: PORT (npm run serve), E2E_PORT and
# PW_CHROMIUM_PATH (playwright.config.js), ENV_FILE (another file than
# .env.local for npm run serve; empty reads none).
