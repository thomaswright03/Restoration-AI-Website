# Copy to .env.local for local testing, or set these as Environment Variables
# in the Vercel project (Settings > Environment Variables). Never commit real values.
# With none set, the site runs in demo mode: the designer demo works, sign-up says
# accounts aren't switched on yet.

# Supabase (Project Settings > API)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Developers > API keys; use test keys sk_test_... first)
STRIPE_SECRET_KEY=
# Developers > Webhooks > your endpoint > Signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Product catalog > your product > the price IDs (price_...)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Free trial length for a first subscription. Keep equal to plans.trialDays in site-config.json.
TRIAL_DAYS=14

# Optional: your real domain, used for Stripe return links (defaults to the request's host)
SITE_URL=

# Optional: email each new homeowner request to the business (resend.com)
RESEND_API_KEY=
LEADS_FROM_EMAIL=
